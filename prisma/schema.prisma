generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  STAFF
  ADMIN
}

enum ComplaintStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  password     String
  role         Role        @default(CITIZEN)
  phone        String?
  address      String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  complaints   Complaint[] @relation("CitizenComplaints")
  assigned     Complaint[] @relation("StaffComplaints")
  feedbacks    Feedback[]
  payments     Payment[]
}

model Category {
  id          String      @id @default(cuid())
  name        String      @unique
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  complaints Complaint[]
}

model Complaint {
  id            String          @id @default(cuid())
  title         String
  description   String
  location      String
  attachmentUrl String?
  status        ComplaintStatus @default(PENDING)
  serviceFee    Decimal         @default(0) @db.Decimal(10,2)
  citizenId     String
  categoryId    String
  assignedToId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  resolvedAt    DateTime?
  citizen       User            @relation("CitizenComplaints", fields: [citizenId], references: [id])
  category      Category        @relation(fields: [categoryId], references: [id])
  assignedTo    User?           @relation("StaffComplaints", fields: [assignedToId], references: [id])
  feedback      Feedback?
  payments      Payment[]

  @@index([status])
  @@index([citizenId])
  @@index([assignedToId])
}

model Feedback {
  id          String    @id @default(cuid())
  rating      Int
  comment     String?
  complaintId String    @unique
  userId      String
  createdAt   DateTime  @default(now())
  complaint   Complaint @relation(fields: [complaintId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model Payment {
  id          String        @id @default(cuid())
  userId      String
  complaintId String
  amount      Decimal       @db.Decimal(10,2)
  currency    String        @default("BDT")
  provider    String        @default("SSLCOMMERZ")
  transactionId String      @unique
  status      PaymentStatus @default(PENDING)
  rawResponse Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  complaint   Complaint     @relation(fields: [complaintId], references: [id])

  @@index([status])
}
